# Firebase web app config as a JSON string (one line).
# Copy from Firebase Console > Project settings > Your apps > Web app.
# (scripts/firebase-bootstrap.mjs writes this file for you.)
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"...","storageBucket":"...","messagingSenderId":"..."}

# Set to 1 to point Auth/Firestore at the local emulator suite.
VITE_USE_EMULATOR=0

# ---- App Check (required by Firebase AI Logic, enforced since 2026-11-02) ----
# Pick ONE for the hosted URL:
#  a) reCAPTCHA v3 site key (recommended; register the app in
#     App Check → Apps → Register with reCAPTCHA v3) — real attestation.
VITE_RECAPTCHA_SITE_KEY=
#  b) App Check debug token (accepted by the hackathon rules): run locally once,
#     copy the "AppCheck debug token: ..." printed in the browser console,
#     register it in App Check → Apps → (app) → Manage debug tokens, then paste
#     it here. Works from any origin once registered.
VITE_APPCHECK_DEBUG_TOKEN=
