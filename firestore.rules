rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(data) {
      // Signed-in owner (anonymous uid in v1) — records are per-inspector.
      return request.auth != null && request.auth.uid == data.owner;
    }
    match /projects/{projectId} {
      allow read, update, delete: if isOwner(resource.data);
      allow create: if request.resource.data.owner == request.auth.uid;
      match /records/{recordId} {
        allow read, delete: if false; // records are top-level (see below)
      }
    }
    match /records/{recordId} {
      allow read, update, delete: if isOwner(resource.data);
      allow create: if request.resource.data.owner == request.auth.uid;
    }
  }
}
